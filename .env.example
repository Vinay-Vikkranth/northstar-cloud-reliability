# Local demo only. Copy to .env. Do not put real customer data or production tokens here.
# Tokens below are process-local shared secrets for the synthetic services, not cloud credentials.

CIR_DATABASE_URL=postgresql+psycopg://cir_app:cir_app_local@127.0.0.1:55438/cir
CIR_MIGRATION_DATABASE_URL=postgresql+psycopg://cir_owner:cir_owner_local@127.0.0.1:55438/cir
CRM_DATABASE_URL=postgresql+psycopg://crm_app:crm_app_local@127.0.0.1:55438/crm
SUPPORT_DATABASE_URL=postgresql+psycopg://support_app:support_app_local@127.0.0.1:55438/support

CIR_CRM_BASE_URL=http://127.0.0.1:28611
CIR_SUPPORT_BASE_URL=http://127.0.0.1:28621
CRM_READ_TOKEN=crm-read-local
SUPPORT_TOKEN=support-local
CRM_ADMIN_TOKEN=crm-admin-local
SUPPORT_ADMIN_TOKEN=support-admin-local
CIR_WEBHOOK_SECRET=webhook-local-dev

CIR_API_PORT=8101
CIR_WEB_PORT=8100
CRM_PORT=8111
SUPPORT_PORT=8121

CIR_COOKIE_SECURE=false
CIR_CORS_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
CIR_INVESTIGATOR_MODE=deterministic

# Opt-in external CRM. Leave blank for offline mode. Never commit a real token.
HUBSPOT_TOKEN=
HUBSPOT_CONTACT_ID=
HUBSPOT_PLAN_PROPERTY=
HUBSPOT_BASE_URL=https://api.hubapi.com

# Opt-in live model. Leave blank so offline mode cannot call a provider.
# Example free local server: CIR_LLM_BASE_URL=http://127.0.0.1:11434/v1 and CIR_LLM_MODEL=llama3.2
CIR_LLM_BASE_URL=
CIR_LLM_API_KEY=
CIR_LLM_MODEL=
CIR_LLM_TIMEOUT_SECONDS=30

# Cost policy. Default strict rejects a response that omits cost_usd. It does not store that omission as zero.
# local_unmeasured is the explicit choice for a local server with no monetary price. Token, tool, response-size,
# and elapsed limits still apply. estimated uses the two rates and labels the result an estimate, not a charge.
# CIR_COST_POLICY=strict
# CIR_INPUT_USD_PER_MILLION=0
# CIR_OUTPUT_USD_PER_MILLION=0
# CIR_MAX_ESTIMATED_COST_USD=0.05

CIR_TRACE_PATH=var/traces.jsonl
CIR_LOG_DIR=var/logs
OTEL_EXPORTER_OTLP_ENDPOINT=
