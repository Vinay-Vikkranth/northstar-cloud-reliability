FROM node:22-bookworm-slim AS web
WORKDIR /web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci
COPY apps/web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.lock ./
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 10001 --create-home northstar
COPY apps apps
COPY packages packages
COPY services services
COPY migrations migrations
COPY scripts scripts
COPY deploy deploy
COPY runbooks runbooks
COPY datasets datasets
COPY evaluations evaluations
COPY alembic.ini ./
COPY --from=web /web/dist ./apps/web/dist
RUN mkdir -p /app/var && chown -R 10001:10001 /app/var
ENV PYTHONPATH=/app/apps/api:/app/apps/worker:/app/services/crm_simulator:/app/services/support_service:/app/packages/recovery_core:/app/scripts
USER 10001:10001
EXPOSE 8101
CMD ["python", "-m", "uvicorn", "recovery_api.main:app", "--host", "0.0.0.0", "--port", "8101", "--proxy-headers", "--forwarded-allow-ips", "*"]
